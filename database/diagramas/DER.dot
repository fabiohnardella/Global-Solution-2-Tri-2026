digraph DER {
graph [rankdir=LR, splines=polyline, nodesep=0.45, ranksep=1.3, fontname="Helvetica", bgcolor="white", pad=0.4, label=<<b>Rotas Acessíveis SP — DER (modelo relacional, Oracle)</b>>, labelloc=t, fontsize=22];
